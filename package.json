{
  "name": "texturelabwebsite",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "runtime:build": "tsc -p vendor/texturelab/web/packages/runtime/tsconfig.json",
    "predev": "npm run runtime:build",
    "dev": "node ace serve --hmr",
    "prebuild": "npm run runtime:build",
    "build": "node ace build",
    "pretest": "npm run runtime:build",
    "test": "node ace test",
    "mg": "node ace migration:run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretypecheck": "npm run runtime:build",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/eslint-config": "^2.0.0",
    "@adonisjs/prettier-config": "^1.4.4",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^4.0.0",
    "@japa/runner": "^4.2.0",
    "@swc/core": "1.11.24",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.3",
    "@types/node": "^22.15.18",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.26.0",
    "hot-hook": "^0.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.3",
    "ts-node-maintained": "^10.9.5",
    "typescript": "~5.9.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.4.0",
    "@adonisjs/core": "^6.18.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/drive": "^3.4.1",
    "@adonisjs/inertia": "^3.1.1",
    "@adonisjs/limiter": "^2.4.0",
    "@adonisjs/lucid": "^21.6.1",
    "@adonisjs/redis": "^9.2.0",
    "@adonisjs/session": "^7.5.1",
    "@adonisjs/shield": "^8.2.0",
    "@adonisjs/static": "^1.1.1",
    "@adonisjs/vite": "^4.0.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@inertiajs/react": "^3.6.1",
    "@njbrown/texturelab-runtime": "file:vendor/texturelab/web/packages/runtime",
    "@paralleldrive/cuid2": "^3.3.0",
    "@shikijs/markdown-it": "^4.4.2",
    "@vinejs/vine": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "edge.js": "^6.2.1",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "flydrive": "^2.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.29.0",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
