TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=zKXHe-Ahdb7aPK1ylAJlRgTefktEaACi
NODE_ENV=development
SESSION_DRIVER=cookie

# /ops admin account, seeded with `node ace db:seed`
ADMIN_EMAIL=admin@texturelab.io
ADMIN_PASSWORD=change-me
ADMIN_NAME=TextureLab Admin

# Docker services (docker compose up -d). Host ports are randomised per machine
# to avoid collisions with other local stacks; container ports stay 5432/6379.
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=29607
DB_USER=texturelab
DB_PASSWORD=texturelab
DB_DATABASE=texturelab

REDIS_HOST=localhost
REDIS_PORT=31522
REDIS_PASSWORD=texturelab

# Rate limit counters (redis | memory). Defaults to redis; tests use memory.
LIMITER_STORE=redis

# Texture storage (docker compose up -d starts MinIO and creates the bucket).
# In production point these at DigitalOcean Spaces:
#   S3_ENDPOINT=https://<region>.digitaloceanspaces.com
#   S3_REGION=<region>
#   S3_FORCE_PATH_STYLE=false
#   S3_SUPPORTS_ACL=true
#   S3_PUBLIC_URL=https://<bucket>.<region>.cdn.digitaloceanspaces.com
DRIVE_DISK=s3
MINIO_PORT=30419
MINIO_CONSOLE_PORT=30420
S3_ENDPOINT=http://localhost:30419
S3_REGION=us-east-1
S3_BUCKET=texturelab
S3_ACCESS_KEY_ID=texturelab
S3_SECRET_ACCESS_KEY=texturelab-secret
S3_FORCE_PATH_STYLE=true
S3_SUPPORTS_ACL=false
S3_PUBLIC_URL=http://localhost:30419/texturelab
